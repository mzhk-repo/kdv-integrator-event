# KDV Integrator example environment
# Safe template for local setup and CI validation. Do not put real secrets here.

# Core environment
TZ=Europe/Kyiv
HOST=ci.local
PATH_PREFIX=/kdv/api
EXTERNAL_NETWORK=proxy-net

# Docker image source (GHCR)
KDV_IMAGE_REPOSITORY=ghcr.io/pinokew/kdv-integrator-event
KDV_IMAGE_VERSION=latest
# Optional full override (tag or digest), e.g. ghcr.io/pinokew/kdv-integrator-event:v1.2.3
# KDV_IMAGE=ghcr.io/pinokew/kdv-integrator-event:latest

# PDF optimizer image source. Default flow builds KDV_OPTIMIZER_IMAGE locally in deploy scripts.
# Keep repository as a placeholder for optional GHCR pull fallback.
KDV_OPTIMIZER_IMAGE_REPOSITORY=ghcr.io/OWNER/kdv-optimizer
KDV_OPTIMIZER_VERSION=latest
# Optional full override (local tag or digest), e.g. kdv-optimizer:<git-sha>
# KDV_OPTIMIZER_IMAGE=kdv-optimizer:local

# Swarm deploy image mode used by scripts/deploy-orchestrator-swarm.sh.
# Allowed ORCHESTRATOR_IMAGE_MODE values:
# - local: build LOCAL_IMAGE on the deploy host and use docker stack deploy --resolve-image never.
# - registry: use KDV_IMAGE/KDV_IMAGE_REPOSITORY/KDV_IMAGE_VERSION and registry access.
ORCHESTRATOR_IMAGE_MODE=local
# LOCAL_IMAGE=auto builds kdv-integrator-event:<git-sha>; set an explicit tag if needed.
LOCAL_IMAGE=auto
RUNTIME_ENV_SECRET_BASE=kdv_app_env_payload
SWARM_VERIFY_TIMEOUT=180
SWARM_VERIFY_INTERVAL=5

# API auth
KDV_API_TOKEN=change-me
KDV_AUTH_MODE=legacy
KDV_CORS_ALLOWLIST=https://koha.example.org

# Cloudflare Access (optional, for dual/cf-only mode)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Cloudflare service-token (optional compatibility mode)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Koha
KOHA_API_USER=koha-user
KOHA_API_PASS=change-me
KOHA_API_URL=https://koha.example.org
KOHA_OPAC_URL=https://koha.example.org

# DSpace
DSPACE_API_USER=dspace-user
DSPACE_API_PASS=change-me
DSPACE_SUBMISSION_SECTION=traditionalpageone
DSPACE_API_URL=https://dspace.example.org/server/api
DSPACE_UI_URL=https://dspace.example.org

# Integrator filesystem
# Name of an existing remote from the host rclone config used by the rclone Docker volume plugin.
RCLONE_REMOTE_NAME=gdrive
INTEGRATOR_MOUNT_PATH=/mnt/drive
FOLDER_PROCESSED=Processed
FOLDER_ERROR=Error

# Swarm-only: path is resolved relative to the repository root by Compose.
ENTRYPOINT_SCRYPT_PATH=./scripts/entrypoint.sh
KDV_APP_ENV_PAYLOAD_SECRET_NAME=kdv_app_env_payload


# PDF optimizer service
OPTIMIZER_URL=http://kdv-optimizer:5001
OPTIMIZER_TIMEOUT=130
OPTIMIZER_PORT=5001
DATA_DIR=/data/kdv_optimize
INPUT_DIR=/data/kdv_optimize/input
OUTPUT_DIR=/data/kdv_optimize/output
GS_TIMEOUT=120
QPDF_ENABLED=false
TMP_TTL_SECONDS=86400
TTL_CHECK_INTERVAL_SECONDS=3600

# Batch controls (M7)
ROBOT_PARALLELISM=1
ROBOT_BATCH_DELAY=5
ROBOT_POLL_INTERVAL=3
ROBOT_MAX_WAIT=900
NIGHTWALKER_AUTO_DELAY=0.05
NIGHTWALKER_RANGE_DELAY=0.10
