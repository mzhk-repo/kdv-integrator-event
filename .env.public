# Публічні (non-secret) змінні для Docker Swarm
# Секрети (токени/паролі/ключі) передаються через /run/secrets

# Core
TZ=Europe/Kyiv
EXTERNAL_NETWORK=proxy-net

# Docker image source (GHCR)
KDV_IMAGE_REPOSITORY=ghcr.io/mzhk-repo/kdv-integrator-event
KDV_IMAGE_VERSION=latest
# Optional full override (tag or digest), e.g. ghcr.io/pinokew/kdv-integrator-event:latest
# KDV_IMAGE=ghcr.io/pinokew/kdv-integrator-event:latest

# Routing
HOST=repo.pinokew.buzz
PATH_PREFIX=/kdv/api

# API auth mode and CORS
KDV_AUTH_MODE=dual
KDV_CORS_ALLOWLIST=https://koha.pinokew.buzz

# Koha / DSpace endpoints
KOHA_API_URL=http://koha:8081
KOHA_OPAC_URL=https://library.pinokew.buzz
DSPACE_API_URL=http://dspace:8080/server/api
DSPACE_UI_URL=https://repo.pinokew.buzz
DSPACE_SUBMISSION_SECTION=traditionalpageone

# Integrator filesystem
INTEGRATOR_MOUNT_PATH=/home/pinokew/GoogleDrive/kdv-drive/
FOLDER_PROCESSED=Processed
FOLDER_ERROR=Error

# Batch controls (M7)
ROBOT_PARALLELISM=1
ROBOT_BATCH_DELAY=5
ROBOT_POLL_INTERVAL=3
ROBOT_MAX_WAIT=900
NIGHTWALKER_AUTO_DELAY=0.05
NIGHTWALKER_RANGE_DELAY=0.10
